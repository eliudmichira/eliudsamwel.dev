    {
      "parameters": {
        "operation": "send",
        "to": "{{$json.email}}",
        "subject": "Thank you for contacting Eliud Michira! 🚀",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; }\n        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center; border-radius: 8px 8px 0 0; }\n        .content { padding: 30px; background: #f9f9f9; }\n        .next-steps { background: #e3f2fd; border-left: 4px solid #2196F3; padding: 20px; margin: 20px 0; border-radius: 4px; }\n        .footer { background: #f5f5f5; padding: 20px; border-radius: 0 0 8px 8px; text-align: center; }\n        .contact-info { background: #f0f8ff; padding: 15px; border-radius: 5px; margin: 20px 0; }\n        .highlight { color: #667eea; font-weight: bold; }\n        .emoji { font-size: 1.2em; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>🎉 Thank You!</h1>\n        <p>Your message has been received successfully</p>\n    </div>\n    \n    <div class=\"content\">\n        <h2>Hi {{$json.name}},</h2>\n        \n        <p>Thank you for reaching out! I've received your project inquiry and I'm excited to discuss it with you.</p>\n        \n        <div class=\"next-steps\">\n            <h3>📋 What's Next?</h3>\n            <ul>\n                <li><strong>Review:</strong> I'll carefully review your project requirements</li>\n                <li><strong>Proposal:</strong> Prepare a detailed proposal with timeline and pricing</li>\n                <li><strong>Discussion:</strong> Schedule a call to discuss your project in detail</li>\n                <li><strong>Start:</strong> Begin working on your project once we agree on terms</li>\n            </ul>\n        </div>\n        \n        <p><span class=\"highlight\">⏰ Response Time:</span> I typically respond within <strong>2-4 hours</strong> during business hours.</p>\n        \n        <div class=\"contact-info\">\n            <h3>📞 Quick Contact</h3>\n            <p><strong>Email:</strong> <a href=\"mailto:eliudmichira7@gmail.com\">eliudmichira7@gmail.com</a></p>\n            <p><strong>Phone:</strong> <a href=\"tel:+254705893137\">+254 705 893 137</a></p>\n            <p><strong>LinkedIn:</strong> <a href=\"https://www.linkedin.com/in/eliud-samwel-72b8622b3\">Eliud Samwel</a></p>\n        </div>\n        \n        <p>I'm looking forward to working with you on your project!</p>\n        \n        <p>Best regards,<br>\n        <strong>Eliud Michira</strong><br>\n        <em>Full-Stack Developer & Blockchain Specialist</em></p>\n    </div>\n    \n    <div class=\"footer\">\n        <p>📍 Based in Nairobi, Kenya | 🕒 EAT (UTC+3)</p>\n        <p><small>This is an automated response. I'll send you a personalized reply shortly.</small></p>\n    </div>\n</body>\n</html>"
      },
