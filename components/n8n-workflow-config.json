    {
      "parameters": {
        "jsCode": "// Data validation and processing\nconst requiredFields = ['name', 'email', 'message'];\nconst missingFields = requiredFields.filter(field => !$json[field]);\n\nif (missingFields.length > 0) {\n  throw new Error(`Missing required fields: ${missingFields.join(', ')}`);\n}\n\n// Basic spam filtering\nconst spamKeywords = ['viagra', 'casino', 'lottery', 'crypto', 'bitcoin', 'make money fast'];\nconst message = $json.message.toLowerCase();\nconst isSpam = spamKeywords.some(keyword => message.includes(keyword));\n\n// Add metadata\nconst processedData = {\n  ...$json,\n  isSpam,\n  processedAt: new Date().toISOString(),\n  ipAddress: $json.userAgent ? 'Unknown' : 'Unknown',\n  source: $json.source || 'Portfolio Website'\n};\n\nreturn [{ json: processedData }];"
      },
      "id": "validate-data",
      "name": "Validate & Process Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "to": "eliudmichira7@gmail.com",
        "subject": "🚨 New Portfolio Contact: {{$json.name}}",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n        .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px 8px 0 0; }\n        .content { padding: 20px; background: #f9f9f9; }\n        .field { margin-bottom: 15px; }\n        .label { font-weight: bold; color: #555; }\n        .value { color: #333; }\n        .spam-warning { background: #ffebee; border-left: 4px solid #f44336; padding: 10px; margin: 10px 0; }\n        .footer { background: #f5f5f5; padding: 15px; border-radius: 0 0 8px 8px; font-size: 12px; color: #666; }\n        .cta { background: #4CAF50; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 15px; }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h2>🎯 New Portfolio Contact Form Submission</h2>\n    </div>\n    \n    <div class=\"content\">\n        {{#if $json.isSpam}}\n        <div class=\"spam-warning\">\n            ⚠️ <strong>Potential Spam Detected!</strong> Please review carefully.\n        </div>\n        {{/if}}\n        \n        <div class=\"field\">\n            <div class=\"label\">👤 Name:</div>\n            <div class=\"value\">{{$json.name}}</div>\n        </div>\n        \n        <div class=\"field\">\n            <div class=\"label\">📧 Email:</div>\n            <div class=\"value\"><a href=\"mailto:{{$json.email}}\">{{$json.email}}</a></div>\n        </div>\n        \n        {{#if $json.company}}\n        <div class=\"field\">\n            <div class=\"label\">🏢 Company:</div>\n            <div class=\"value\">{{$json.company}}</div>\n        </div>\n        {{/if}}\n        \n        {{#if $json.budget}}\n        <div class=\"field\">\n            <div class=\"label\">💰 Budget:</div>\n            <div class=\"value\">{{$json.budget}}</div>\n        </div>\n        {{/if}}\n        \n        {{#if $json.services}}\n        <div class=\"field\">\n            <div class=\"label\">🛠️ Services:</div>\n            <div class=\"value\">{{$json.services}}</div>\n        </div>\n        {{/if}}\n        \n        {{#if $json.timeline}}\n        <div class=\"field\">\n            <div class=\"label\">⏰ Timeline:</div>\n            <div class=\"value\">{{$json.timeline}}</div>\n        </div>\n        {{/if}}\n        \n        <div class=\"field\">\n            <div class=\"label\">💬 Message:</div>\n            <div class=\"value\">{{$json.message}}</div>\n        </div>\n        \n        <hr style=\"margin: 20px 0;\">\n        \n        <div class=\"field\">\n            <div class=\"label\">📅 Submitted:</div>\n            <div class=\"value\">{{$json.timestamp}}</div>\n        </div>\n        \n        <div class=\"field\">\n            <div class=\"label\">🌐 Source:</div>\n            <div class=\"value\">{{$json.source}}</div>\n        </div>\n        \n        {{#if $json.referrer}}\n        <div class=\"field\">\n            <div class=\"label\">🔗 Referrer:</div>\n            <div class=\"value\">{{$json.referrer}}</div>\n        </div>\n        {{/if}}\n        \n        <div style=\"margin-top: 25px;\">\n            <a href=\"mailto:{{$json.email}}?subject=Re: Your Portfolio Inquiry&body=Hi {{$json.name}},%0D%0A%0D%0AThank you for reaching out! I've received your project inquiry and I'm excited to discuss it with you.%0D%0A%0D%0AI'll review your requirements and get back to you with a detailed proposal within 2-4 hours.%0D%0A%0D%0ABest regards,%0D%0AEliud Michira\" class=\"cta\">\n                ✉️ Reply to {{$json.name}}\n            </a>\n        </div>\n    </div>\n    \n    <div class=\"footer\">\n        <p>This message was automatically generated by your portfolio contact form.</p>\n        <p>Processed at: {{$json.processedAt}}</p>\n    </div>\n</body>\n</html>"
      },
